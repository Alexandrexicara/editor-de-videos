# PostgreSQL production database (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to disable only for local PostgreSQL without TLS.
PGSSLMODE=require
PG_POOL_MAX=10

# Long random secret; never commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_API_KEY=optional-long-admin-only-secret

# SumUp Developer credentials.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Modo/moeda padrão para a conta própria; a carteira atual aceita BRL e USD.
SUMUP_MODE=production
SUMUP_CURRENCY=BRL

# Reservado para futura conexão OAuth de contas de terceiros (não usado na carteira atual).
SUMUP_OAUTH_CLIENT_ID=
SUMUP_OAUTH_CLIENT_SECRET=
SUMUP_REDIRECT_URI=

# Public HTTPS address of this backend, without trailing slash.
PUBLIC_BASE_URL=https://your-domain.example

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# ElevenLabs — Cine Séries (use sua chave privada; nunca a publique no GitHub)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=GIuLCSVfgJaUuh7hYOY8

# NVIDIA NIM — geração e edição de imagens do Cine Séries (chave privada)
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct

# 0 preserva vídeos finais sem expiração automática; defina dias apenas se desejar retenção.
MAX_OUTPUT_AGE_DAYS=0
# Limites HTTP: JSON comum pequeno; referências do Cine Séries até 8 imagens de 5 MB.
JSON_BODY_LIMIT=1mb
CINE_IMAGE_JSON_LIMIT=56mb
