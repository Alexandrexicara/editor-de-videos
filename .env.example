# Copie para .env local ou configure os mesmos nomes no Render Environment.
# Nunca preencha valores reais neste arquivo nem faça commit do arquivo .env.

# SumUp - conta própria da plataforma
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_MODE=production
SUMUP_CURRENCY=BRL

# OAuth - somente se futuramente outras igrejas/lojistas conectarem suas contas
SUMUP_OAUTH_CLIENT_ID=
SUMUP_OAUTH_CLIENT_SECRET=
SUMUP_REDIRECT_URI=

# Outras integrações existentes (preencha somente se utilizadas)
SYNC_API_KEY=
